{
  "name": "@drillke/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lyrics": {
      "types": "./src/lyrics.ts",
      "import": "./src/lyrics.ts",
      "require": "./dist/lyrics.js",
      "default": "./dist/lyrics.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
