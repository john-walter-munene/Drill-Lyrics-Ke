# Docker dev stack overrides (infra/docker-compose.dev.yml).
# Copy to `.env.local` and change only what clashes with other local projects.
#
# Host ports — the defaults deliberately avoid 5432/6379, which other projects
# commonly use. Inside the containers the apps always talk to `db:5432`.
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433
REDIS_PORT=6380

# Browser-facing URLs (what your browser uses to reach the containers).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Dev-only secret — must be >= 32 chars. Not used in production.
JWT_SECRET=dev-only-secret-please-change-0123456789abcdef

LOG_LEVEL=debug

# Optional: enables the YouTube metadata import when set.
YOUTUBE_API_KEY=

# Seeded admin account (auth is wired in Phase 1).
SEED_ADMIN_EMAIL=admin@drillke.local
