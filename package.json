{
  "name": "drillke",
  "version": "0.1.0",
  "private": true,
  "description": "DrillKe — the home of Kenyan drill. One track at a time.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@drillke/web",
    "dev:api": "npm run start:dev --workspace=@drillke/api",
    "build": "npm run build -w @drillke/shared && npm run build -w @drillke/api && npm run build -w @drillke/web",
    "start": "npm run start -w @drillke/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:shared && npm run test:api",
    "test:shared": "node --experimental-strip-types --test \"packages/shared/src/*.test.ts\"",
    "test:api": "node --experimental-strip-types --test \"apps/api/src/common/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "dev:stack": "docker compose -f infra/docker-compose.dev.yml --profile dev up --build",
    "dev:stack:bg": "docker compose -f infra/docker-compose.dev.yml --profile dev up --build -d",
    "dev:stack:down": "docker compose -f infra/docker-compose.dev.yml --profile dev down",
    "dev:stack:reset": "docker compose -f infra/docker-compose.dev.yml --profile dev down -v",
    "dev:stack:logs": "docker compose -f infra/docker-compose.dev.yml logs -f api web",
    "dev:clean": "docker compose -f infra/docker-compose.dev.yml --profile dev down -v --remove-orphans",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "stack:up": "docker compose -f infra/docker-compose.full.yml up --build",
    "stack:down": "docker compose -f infra/docker-compose.full.yml down",
    "docker:build:dev": "docker compose -f infra/docker-compose.dev.yml build",
    "docker:build:api": "docker build -f Dockerfile -t drillke-api:latest .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t drillke-web:latest .",
    "docker:build": "npm run docker:build:dev && npm run docker:build:api && npm run docker:build:web",
    "docker:test": "docker compose -f infra/docker-compose.dev.yml run --rm install npm test",
    "docker:typecheck": "docker compose -f infra/docker-compose.dev.yml run --rm install npm run typecheck",
    "docker:lint": "docker compose -f infra/docker-compose.dev.yml run --rm install npm run lint",
    "docker:check": "npm run docker:typecheck && npm run docker:test && npm run docker:lint",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force && npm run db:seed"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "prisma": "^6.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
