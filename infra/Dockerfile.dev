# syntax=docker/dockerfile:1
# Development image for DrillKe — used by infra/docker-compose.dev.yml.
#
# Unlike the production root Dockerfile, this image keeps the full workspace,
# runs as the non-root `node` user and installs dependencies INSIDE the
# container on first boot. That means:
#   * host node_modules never enters the image (no cross-OS native binary clash),
#   * containers are self-sufficient and reproducible,
#   * nothing outside this compose project is affected.

FROM node:22-bookworm-slim

WORKDIR /app

# Prisma needs openssl; curl is used by the web healthcheck.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# The workspace root and every package manifest are bind-mounted at runtime.
# We only pre-create the directories here so Docker volumes inherit the right
# ownership (avoids root-owned node_modules on the project volume).
RUN mkdir -p node_modules apps/web/.next apps/api apps/web packages/shared prisma infra /home/node/.npm \
 && chown -R node:node /app /home/node

USER node

ENV NODE_ENV=development
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

EXPOSE 3000 4000

# Default command is provided per-service by compose.
CMD ["node", "--version"]
