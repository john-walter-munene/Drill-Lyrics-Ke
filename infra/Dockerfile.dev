# syntax=docker/dockerfile:1
# ─── Development image (hot reload) ────────────────────────────────────────
# Used by `infra/docker-compose.dev.yml` via `npm run dev:stack`. It keeps the
# FULL workspace and the toolchain, so source files are bind-mounted and edited
# on the host while the containers recompile and reload.
#
# Dependencies are NOT installed here: the `install` service runs `npm ci` into
# a shared named volume at first boot, so the Linux-native binaries inside the
# container never clash with the host's node_modules.
#
# The image starts as root so the backend entrypoint can chown/initialise the
# PostgreSQL data volume; each API process is exec'd as the `node` user.

FROM node:22-bookworm-slim

WORKDIR /app

# Prisma needs openssl; curl/wget are used by healthchecks. PostgreSQL lets this
# container host the database, exactly like the production backend image.
#
# This deliberately uses Debian's own `postgresql` package instead of the
# third-party PGDG repo. apt.postgresql.org is frequently slow or unreachable
# (TLS handshakes time out), which made `docker build` fail for reasons that
# have nothing to do with this project — the production Dockerfile made the same
# choice for the same reason. The major version is whatever Debian ships (15 on
# bookworm); the entrypoint discovers it rather than assuming a path.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates curl wget postgresql \
 && rm -rf /var/lib/apt/lists/* \
 && pg_major="$(ls /usr/lib/postgresql | sort -n | tail -1)" \
 && echo "/usr/lib/postgresql/${pg_major}/bin" > /etc/drillke-pg-bin \
 && echo "PostgreSQL major version: ${pg_major}"

# Postgres server binaries are not on PATH by default. The entrypoint reads
# /etc/drillke-pg-bin, so this is only a convenience for interactive shells.
ENV PATH="/usr/lib/postgresql/15/bin:${PATH}"

# Pre-create the directories that become volumes so their ownership is right
# when the non-root user writes to them.
RUN mkdir -p node_modules apps/api/dist apps/web/.next packages/shared/dist /home/node/.npm \
 && chown -R node:node /app /home/node

ENV NODE_ENV=development

EXPOSE 3000 4000

# Per-service commands are provided by compose.
CMD ["node", "--version"]
