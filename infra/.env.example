# Copy to infra/.env to override the compose defaults, then
#   docker compose -f infra/docker-compose.yml up -d --build
# Every value below is optional; the defaults work for local development.

# ── Ports on your host ──────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432

# ── Database (runs inside the backend container) ────────────────────────────
POSTGRES_DB=drillke
POSTGRES_USER=drillke
POSTGRES_PASSWORD=drillke

# ── API ─────────────────────────────────────────────────────────────────────
# Generate a real secret before exposing this stack: openssl rand -hex 32
JWT_SECRET=local-dev-only-secret-change-before-deploying-0000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
MAX_BODY_SIZE=512kb

# ── Seed ────────────────────────────────────────────────────────────────────
# Set to false after the first boot to skip re-seeding on restart.
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@drillke.local
SEED_ADMIN_PASSWORD=change-me-now

# ── Frontend (baked into the browser bundle at build time) ──────────────────
# Change these BEFORE the first `--build`, or rebuild the web image after.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── YouTube import (optional; empty = disabled, playback still works) ───────
YOUTUBE_API_KEY=
EMBED_WORKER=false
