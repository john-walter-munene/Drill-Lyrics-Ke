# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Environment (never commit secrets)
# ONE env file: `.env` at the repo root (copy `.env.example`). It serves both
# the Docker stack and host `npm run dev`. `.env*.backup*` are local copies made
# while consolidating, never intended for a commit.
.env
.env.*
.env*.backup*
!.env.example

# Prisma
prisma/*.db
prisma/*.db-journal

# Tests
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Content exports (generated by `npm run content:export`)
content/

# Logs (dev run scripts write *.log / *.err.log at the root)
*.log
*.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
# Only share extension recommendations; settings.json is per-developer and may
# hold local secrets (API keys), so it must never be committed.
!.vscode/extensions.json
