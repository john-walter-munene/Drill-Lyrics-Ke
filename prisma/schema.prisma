// DrillKe — Prisma schema (v1)
// See docs/architecture.md §4 for the data model and modelling decisions.
//
// Rules of note:
//   - LyricVersion is immutable once approved; lines/annotations hang off it.
//   - Songs reference media (YouTube) and never host it.
//   - Artists and DJs are separate entities; a person can be both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  contributor
  moderator
  admin
}

enum Language {
  sheng
  swahili
  english
  mixed
}

enum SongStatus {
  draft
  pending
  published
  unpublished
}

/// Lifecycle of a lyrics submission. `published` is terminal for a version;
/// a later edit creates a new submission rather than reopening this one.
enum SubmissionStatus {
  draft
  pending
  changes_requested
  approved
  published
  rejected
  unpublished
}

/// Whether a lyric version carries per-line timing. Explicit, because the UI
/// must never imply lyrics are synced when they are not.
enum SyncStatus {
  unsynchronized
  synchronized
}

enum PodcastPlatform {
  youtube
  spotify
  anchor
  other
}

/// Categories a report can target. The target itself is (targetType,targetId)
/// rather than a foreign key per entity — see docs/architecture.md §4.
enum ReportTargetType {
  song
  lyric_version
  annotation
  artist
  dj
  podcast_episode
  event
  user
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ArtistSuggestionStatus {
  pending
  approved
  rejected
}

/// Where a competition is in its lifecycle (docs/context.md §Competition
/// lifecycle). `draft` is invisible to the public; `published` is announced but
/// not yet open; `voting_open` accepts votes; `voting_closed` is the gap between
/// the last vote and the published result; `results_published` is final.
enum CompetitionStatus {
  draft
  published
  voting_open
  voting_closed
  results_published
}

/// The three rounds every competition runs through. A stage is a row, not a
/// column, so each round keeps its own window, its own entrants and its own
/// votes — which is what makes the results of round one still readable after
/// the final has been decided.
enum CompetitionStageKind {
  quarterfinal
  semifinal
  final
}

enum CompetitionStageStatus {
  pending
  voting_open
  voting_closed
  completed
}

/// Who may vote. `public` is one vote per device per stage; `account` needs a
/// signed-in account; `committee` is restricted to the competition's committee.
enum CompetitionVoterScope {
  public
  account
  committee
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String?
  role         Role     @default(member)
  /// When the address was confirmed. Null means unconfirmed.
  ///
  /// Unconfirmed accounts can browse, read and submit lyrics — v1 does not
  /// punish a visitor for not opening an email. The flag exists so the account
  /// page can prompt, and so a future feature that needs a proven address can
  /// gate on it. Seeded and moderator-created accounts are confirmed.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions     LyricsSubmission[]
  reports         Report[]
  auditLogs       AuditLog[]
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  emailConfirms   EmailConfirmationToken[]
  artistSuggestions ArtistSuggestion[] @relation("ArtistSuggestionSubmitter")
  reviewedArtistSuggestions ArtistSuggestion[] @relation("ArtistSuggestionReviewer")
  committeeMemberships CompetitionCommitteeMember[]
  votes           CompetitionVote[]

  @@index([role])
}

/// A single-use email-confirmation link.
///
/// Same rules as `PasswordResetToken`: only the SHA-256 is stored, it is
/// single-use, and it expires. Kept as a separate table rather than a `kind`
/// column so one token can never be spent as the other — a confirmation link
/// that could reset a password would be a privilege escalation.
model EmailConfirmationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A single-use password-reset link.
///
/// Only the SHA-256 of the token is stored: a database leak must not hand an
/// attacker working reset links. `usedAt` is kept rather than deleted so a
/// replay attempt is distinguishable from a forged token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Revocable JWT sessions. Activity is tracked server-side for rolling inactivity expiry.
model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, expiresAt, lastActivityAt])
  @@index([expiresAt])
}

model Artist {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  bio              String?
  imageUrl         String?
  youtubeChannelId String?  @unique
  youtubeSyncEnabled Boolean @default(false)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  links    ArtistLink[]
  songs    SongArtist[]
  youtubeSync YoutubeChannelSync?
  episodes PodcastEpisodeArtist[]
  events   EventArtist[]

  @@index([name])
}

/// Guest or signed-in channel suggestions wait for human confirmation before
/// an artist is created or imports become public.
model ArtistSuggestion {
  id                 String                 @id @default(cuid())
  youtubeChannelId   String                 @unique
  channelTitle       String
  channelDescription String?
  suggestedName      String?
  sampleVideos       Json
  submitterId        String?
  submitter          User?                  @relation("ArtistSuggestionSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  status             ArtistSuggestionStatus @default(pending)
  reviewerId         String?
  reviewer           User?                  @relation("ArtistSuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote         String?
  createdAt          DateTime               @default(now())
  reviewedAt         DateTime?

  @@index([status, createdAt])
}

/// Cursor and status for importing an artist's public YouTube uploads.
model YoutubeChannelSync {
  id                   String   @id @default(cuid())
  artistId             String   @unique
  artist               Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  uploadsPlaylistId    String?
  nextPageToken        String?
  initialImportComplete Boolean @default(false)
  lastSyncAt           DateTime?
  lastError             String?
  lastScanned           Int      @default(0)
  lastCreated           Int      @default(0)
  /// Imports stopped because the channel holds videos that look non-musical.
  /// Cleared by the admin's "import everything" action.
  pausedByFilter       Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model ArtistLink {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  label    String
  url      String

  @@index([artistId])
}

model Dj {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  bio       String?
  imageUrl  String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links   DjLink[]
  tracks  DjTrack[]
  events  EventDj[]

  @@index([name])
  @@index([city])
}

model DjLink {
  id     String @id @default(cuid())
  djId   String
  dj     Dj     @relation(fields: [djId], references: [id], onDelete: Cascade)
  label  String
  url    String

  @@index([djId])
}

/// A song a DJ is known to spin — a curated association, not a play count.
model DjTrack {
  djId   String
  dj     Dj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  songId String
  song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  rank   Int  @default(0)

  @@id([djId, songId])
  @@index([songId])
}

model Song {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  youtubeVideoId String
  language       Language   @default(mixed)
  releaseDate    DateTime?  @db.Date
  durationMs     Int?
  youtubeImported Boolean  @default(false)
  youtubeMetadataRefreshedAt DateTime?
  /// What the importer thought this upload was (audio | video | unclear), and
  /// why. Kept so the admin can judge a candidate without re-querying YouTube.
  youtubeImportKind     String?
  youtubeImportReason   String?
  status         SongStatus @default(draft)
  // Denormalised for catalogue sorting without joining versions.
  syncedVersionId String?
  /// When the pointed-at version became the live timed one. `syncedVersionId`
  /// is a cuid, so ordering by it orders by creation batch, not by time — the
  /// catalogue's "recently synced" sort needs this column. Null exactly when
  /// `syncedVersionId` is null (backfilled from `updatedAt` once).
  syncedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  artists    SongArtist[]
  versions   LyricVersion[]
  djTracks   DjTrack[]
  episodes   PodcastEpisodeSong[]
  submissions LyricsSubmission[]

  @@index([status, releaseDate])
  @@index([status, syncedAt])
  @@index([status, syncedVersionId])
  @@index([title])
  // One SONG per video, in every direction. Drafts used to be allowed to reuse
  // an id, so a re-import could re-create a video that was already catalogued
  // — which is how a channel sync created rows forever. The importer now upserts
  // on this key; the index makes that guarantee hold in the database too.
  @@unique([youtubeVideoId])
  @@index([youtubeImported, status])
}

/// Join table so a song can credit a primary artist plus features.
model SongArtist {
  songId     String
  song       Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artistId   String
  artist     Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  isPrimary  Boolean @default(true)
  position   Int    @default(0)

  @@id([songId, artistId])
  @@index([artistId])
}

/// An immutable, reviewable version of a song's lyrics. Approving an edit
/// creates a new row; the previous one stays queryable for rollback.
model LyricVersion {
  id           String       @id @default(cuid())
  songId       String
  song         Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  version      Int
  syncStatus   SyncStatus   @default(unsynchronized)
  source       String       @default("community")
  published    Boolean      @default(false)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  lines       LyricLine[]
  annotations Annotation[]
  publishedFrom LyricsSubmission? @relation("SubmissionPublishedVersion")

  @@unique([songId, version])
  @@index([songId, published])
}

/// A single lyric line. `startMs` is -1 when the version is unsynchronized,
/// so untimed lines keep their order without a nullable sort key.
model LyricLine {
  id        String       @id @default(cuid())
  versionId String
  version   LyricVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  index     Int
  startMs   Int          @default(-1)
  text      String

  @@unique([versionId, index])
  @@index([versionId, startMs])
}

model Annotation {
  id          String       @id @default(cuid())
  versionId   String
  version     LyricVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  phrase      String
  explanation String
  // 0-based line pointer, resolved from the phrase when the author omitted it.
  lineIndex   Int?

  @@index([versionId])
}

model LyricsSubmission {
  id         String           @id @default(cuid())
  songId     String
  song       Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     SubmissionStatus @default(pending)
  // Raw Markdown as submitted — the audit record of what was actually sent.
  markdown   String
  note       String?
  creditPublicly Boolean @default(false)
  contributorName String?
  publishedVersionId String? @unique
  publishedVersion LyricVersion? @relation("SubmissionPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([songId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Podcast {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  hostName    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes PodcastEpisode[]
}

model PodcastEpisode {
  id          String          @id @default(cuid())
  podcastId   String
  podcast     Podcast         @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?
  publishedAt DateTime
  durationMs  Int?
  externalUrl String
  platform    PodcastPlatform @default(youtube)

  songs   PodcastEpisodeSong[]
  artists PodcastEpisodeArtist[]

  @@unique([podcastId, number])
  @@index([publishedAt])
}

model PodcastEpisodeSong {
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  songId    String
  song      Song           @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([episodeId, songId])
  @@index([songId])
}

model PodcastEpisodeArtist {
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([episodeId, artistId])
  @@index([artistId])
}

/// Informational only in v1 — ticketUrl is an outbound link, never a payment.
model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  venue       String?
  city        String
  startsAt    DateTime
  endsAt      DateTime?
  ticketUrl   String?
  ticketPrice String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artists EventArtist[]
  djs     EventDj[]

  @@index([startsAt])
  @@index([city, startsAt])
}

model EventArtist {
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
}

model EventDj {
  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djId    String
  dj      Dj    @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@id([eventId, djId])
  @@index([djId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String?
  reporter   User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType ReportTargetType
  targetId   String
  reason     String
  detail     String?
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// A playlist competition (docs/context.md §Playlists and Competitions).
///
/// The lifecycle is `status`; the rounds are `stages`. A competition is created
/// as a draft, its committee is appointed by an admin, and each stage is opened
/// and closed explicitly — nothing advances on a timer, so a result is never
/// published by a clock the organiser did not set.
model Competition {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  organizer   String?
  status      CompetitionStatus @default(draft)
  /// How a vote is counted. `one_per_device` is the live rule; the others are
  /// kept so a competition can be re-run under a different rule without a
  /// schema change.
  voterScope  CompetitionVoterScope @default(public)
  /// Whether a voter may change their pick while a stage is open.
  allowVoteChange Boolean        @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  stages    CompetitionStage[]
  entries   CompetitionEntry[]
  committee CompetitionCommitteeMember[]
  votes     CompetitionVote[]

  @@index([status, createdAt])
}

/// One round of a competition. `order` is 1, 2, 3 for quarterfinal, semifinal,
/// final; `advancing` is how many entrants move on from this round (0 for the
/// final, which produces a winner instead).
model CompetitionStage {
  id            String                 @id @default(cuid())
  competitionId String
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  kind          CompetitionStageKind
  order         Int
  title         String
  status        CompetitionStageStatus @default(pending)
  opensAt       DateTime?
  closesAt      DateTime?
  advancing     Int                    @default(0)
  /// Set when an organiser resolves a tie across the cut line. The chosen
  /// entrant advances; the reason is kept so the decision is explainable.
  tiebreakEntryId String?
  tiebreakReason  String?
  tiebreakById    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  entrants CompetitionStageEntrant[]
  votes    CompetitionVote[]

  @@unique([competitionId, order])
  @@index([competitionId, status])
}

/// A playlist entered in a competition. The playlist itself is a title and a
/// curator for now; linking it to a `Playlist` row is a later step.
model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  curator       String
  description   String?
  /// Optional cover; the UI falls back to a generated tile.
  imageUrl      String?
  createdAt     DateTime @default(now())

  stages CompetitionStageEntrant[]
  votes  CompetitionVote[]

  @@unique([competitionId, slug])
  @@index([competitionId])
}

/// Which entries are in which stage. A row per (stage, entry) so an entry can
/// be eliminated in the quarterfinal and still be listed there afterwards.
model CompetitionStageEntrant {
  stageId String
  stage   CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  entryId String
  entry   CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Seed within the stage, for a stable display order before any votes.
  position Int @default(0)

  @@id([stageId, entryId])
  @@index([entryId])
}

/// A committee member appointed by an admin. Removing a member is a soft
/// delete (`removedAt`) so their past votes stay attributable in the audit
/// trail; a removed member can no longer vote or see the committee view.
model CompetitionCommitteeMember {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String      @default("member")
  addedById     String?
  addedAt       DateTime    @default(now())
  /// Who removed the member and why. Kept so the audit trail explains a gap in
  /// the committee rather than just showing a member who stopped voting.
  removedById   String?
  removedAt     DateTime?
  removalReason String?

  @@unique([competitionId, userId])
  @@index([competitionId, removedAt])
}

/// One vote. `voterKey` is the identity the rule was enforced against: the
/// account id for account/committee voting, or a device fingerprint for public
/// voting. The unique key is (stage, voterKey) — the database, not the service,
/// is what makes a second vote impossible.
model CompetitionVote {
  id            String   @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stageId       String
  stage         CompetitionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  entryId       String
  entry         CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  voterKey      String
  /// How the vote was cast, for the audit trail: `device` or `account`.
  method        String   @default("device")
  /// SHA-256 of the browser's device token, when one was presented. The raw
  /// token never leaves the browser; this is what lets the live rule refuse a
  /// second device for the same account. Null for votes cast before the device
  /// rule was enforced (and for the seeded test votes).
  deviceHash    String?
  /// Set when an admin invalidates a vote; invalidated votes are excluded from
  /// every tally but kept so the record is complete.
  invalidatedAt DateTime?
  invalidatedById String?
  createdAt     DateTime @default(now())

  @@unique([stageId, voterKey])
  @@index([competitionId, createdAt])
  @@index([entryId])
}

/// Append-only record of privileged actions (reviews, role changes, unpublish).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
