// DrillKe — Prisma schema (v1)
// See docs/architecture.md §4 for the data model and modelling decisions.
//
// Rules of note:
//   - LyricVersion is immutable once approved; lines/annotations hang off it.
//   - Songs reference media (YouTube) and never host it.
//   - Artists and DJs are separate entities; a person can be both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  contributor
  moderator
  admin
}

enum Language {
  sheng
  swahili
  english
  mixed
}

enum SongStatus {
  draft
  pending
  published
  unpublished
}

/// Lifecycle of a lyrics submission. `published` is terminal for a version;
/// a later edit creates a new submission rather than reopening this one.
enum SubmissionStatus {
  draft
  pending
  changes_requested
  approved
  published
  rejected
  unpublished
}

/// Whether a lyric version carries per-line timing. Explicit, because the UI
/// must never imply lyrics are synced when they are not.
enum SyncStatus {
  unsynchronized
  synchronized
}

enum PodcastPlatform {
  youtube
  spotify
  anchor
  other
}

/// Categories a report can target. The target itself is (targetType,targetId)
/// rather than a foreign key per entity — see docs/architecture.md §4.
enum ReportTargetType {
  song
  lyric_version
  annotation
  artist
  dj
  podcast_episode
  event
  user
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ArtistSuggestionStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String?
  role         Role     @default(member)
  /// When the address was confirmed. Null means unconfirmed.
  ///
  /// Unconfirmed accounts can browse, read and submit lyrics — v1 does not
  /// punish a visitor for not opening an email. The flag exists so the account
  /// page can prompt, and so a future feature that needs a proven address can
  /// gate on it. Seeded and moderator-created accounts are confirmed.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions     LyricsSubmission[]
  reports         Report[]
  auditLogs       AuditLog[]
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  emailConfirms   EmailConfirmationToken[]
  artistSuggestions ArtistSuggestion[] @relation("ArtistSuggestionSubmitter")
  reviewedArtistSuggestions ArtistSuggestion[] @relation("ArtistSuggestionReviewer")

  @@index([role])
}

/// A single-use email-confirmation link.
///
/// Same rules as `PasswordResetToken`: only the SHA-256 is stored, it is
/// single-use, and it expires. Kept as a separate table rather than a `kind`
/// column so one token can never be spent as the other — a confirmation link
/// that could reset a password would be a privilege escalation.
model EmailConfirmationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A single-use password-reset link.
///
/// Only the SHA-256 of the token is stored: a database leak must not hand an
/// attacker working reset links. `usedAt` is kept rather than deleted so a
/// replay attempt is distinguishable from a forged token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Revocable JWT sessions. Activity is tracked server-side for rolling inactivity expiry.
model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, expiresAt, lastActivityAt])
  @@index([expiresAt])
}

model Artist {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  bio              String?
  imageUrl         String?
  youtubeChannelId String?  @unique
  youtubeSyncEnabled Boolean @default(false)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  links    ArtistLink[]
  songs    SongArtist[]
  youtubeSync YoutubeChannelSync?
  episodes PodcastEpisodeArtist[]
  events   EventArtist[]

  @@index([name])
}

/// Guest or signed-in channel suggestions wait for human confirmation before
/// an artist is created or imports become public.
model ArtistSuggestion {
  id                 String                 @id @default(cuid())
  youtubeChannelId   String                 @unique
  channelTitle       String
  channelDescription String?
  suggestedName      String?
  sampleVideos       Json
  submitterId        String?
  submitter          User?                  @relation("ArtistSuggestionSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  status             ArtistSuggestionStatus @default(pending)
  reviewerId         String?
  reviewer           User?                  @relation("ArtistSuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote         String?
  createdAt          DateTime               @default(now())
  reviewedAt         DateTime?

  @@index([status, createdAt])
}

/// Cursor and status for importing an artist's public YouTube uploads.
model YoutubeChannelSync {
  id                   String   @id @default(cuid())
  artistId             String   @unique
  artist               Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  uploadsPlaylistId    String?
  nextPageToken        String?
  initialImportComplete Boolean @default(false)
  lastSyncAt           DateTime?
  lastError             String?
  lastScanned           Int      @default(0)
  lastCreated           Int      @default(0)
  /// Imports stopped because the channel holds videos that look non-musical.
  /// Cleared by the admin's "import everything" action.
  pausedByFilter       Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model ArtistLink {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  label    String
  url      String

  @@index([artistId])
}

model Dj {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  bio       String?
  imageUrl  String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links   DjLink[]
  tracks  DjTrack[]
  events  EventDj[]

  @@index([name])
  @@index([city])
}

model DjLink {
  id     String @id @default(cuid())
  djId   String
  dj     Dj     @relation(fields: [djId], references: [id], onDelete: Cascade)
  label  String
  url    String

  @@index([djId])
}

/// A song a DJ is known to spin — a curated association, not a play count.
model DjTrack {
  djId   String
  dj     Dj   @relation(fields: [djId], references: [id], onDelete: Cascade)
  songId String
  song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  rank   Int  @default(0)

  @@id([djId, songId])
  @@index([songId])
}

model Song {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  youtubeVideoId String
  language       Language   @default(mixed)
  releaseDate    DateTime?  @db.Date
  durationMs     Int?
  youtubeImported Boolean  @default(false)
  youtubeMetadataRefreshedAt DateTime?
  /// What the importer thought this upload was (audio | video | unclear), and
  /// why. Kept so the admin can judge a candidate without re-querying YouTube.
  youtubeImportKind     String?
  youtubeImportReason   String?
  status         SongStatus @default(draft)
  // Denormalised for catalogue sorting without joining versions.
  syncedVersionId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  artists    SongArtist[]
  versions   LyricVersion[]
  djTracks   DjTrack[]
  episodes   PodcastEpisodeSong[]
  submissions LyricsSubmission[]

  @@index([status, releaseDate])
  @@index([title])
  // One SONG per video, in every direction. Drafts used to be allowed to reuse
  // an id, so a re-import could re-create a video that was already catalogued
  // — which is how a channel sync created rows forever. The importer now upserts
  // on this key; the index makes that guarantee hold in the database too.
  @@unique([youtubeVideoId])
  @@index([youtubeImported, status])
}

/// Join table so a song can credit a primary artist plus features.
model SongArtist {
  songId     String
  song       Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artistId   String
  artist     Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  isPrimary  Boolean @default(true)
  position   Int    @default(0)

  @@id([songId, artistId])
  @@index([artistId])
}

/// An immutable, reviewable version of a song's lyrics. Approving an edit
/// creates a new row; the previous one stays queryable for rollback.
model LyricVersion {
  id           String       @id @default(cuid())
  songId       String
  song         Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  version      Int
  syncStatus   SyncStatus   @default(unsynchronized)
  source       String       @default("community")
  published    Boolean      @default(false)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())

  lines       LyricLine[]
  annotations Annotation[]
  publishedFrom LyricsSubmission? @relation("SubmissionPublishedVersion")

  @@unique([songId, version])
  @@index([songId, published])
}

/// A single lyric line. `startMs` is -1 when the version is unsynchronized,
/// so untimed lines keep their order without a nullable sort key.
model LyricLine {
  id        String       @id @default(cuid())
  versionId String
  version   LyricVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  index     Int
  startMs   Int          @default(-1)
  text      String

  @@unique([versionId, index])
  @@index([versionId, startMs])
}

model Annotation {
  id          String       @id @default(cuid())
  versionId   String
  version     LyricVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  phrase      String
  explanation String
  // 0-based line pointer, resolved from the phrase when the author omitted it.
  lineIndex   Int?

  @@index([versionId])
}

model LyricsSubmission {
  id         String           @id @default(cuid())
  songId     String
  song       Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status     SubmissionStatus @default(pending)
  // Raw Markdown as submitted — the audit record of what was actually sent.
  markdown   String
  note       String?
  creditPublicly Boolean @default(false)
  contributorName String?
  publishedVersionId String? @unique
  publishedVersion LyricVersion? @relation("SubmissionPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([songId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Podcast {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  hostName    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes PodcastEpisode[]
}

model PodcastEpisode {
  id          String          @id @default(cuid())
  podcastId   String
  podcast     Podcast         @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?
  publishedAt DateTime
  durationMs  Int?
  externalUrl String
  platform    PodcastPlatform @default(youtube)

  songs   PodcastEpisodeSong[]
  artists PodcastEpisodeArtist[]

  @@unique([podcastId, number])
  @@index([publishedAt])
}

model PodcastEpisodeSong {
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  songId    String
  song      Song           @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([episodeId, songId])
  @@index([songId])
}

model PodcastEpisodeArtist {
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([episodeId, artistId])
  @@index([artistId])
}

/// Informational only in v1 — ticketUrl is an outbound link, never a payment.
model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  venue       String?
  city        String
  startsAt    DateTime
  endsAt      DateTime?
  ticketUrl   String?
  ticketPrice String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artists EventArtist[]
  djs     EventDj[]

  @@index([startsAt])
  @@index([city, startsAt])
}

model EventArtist {
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
}

model EventDj {
  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djId    String
  dj      Dj    @relation(fields: [djId], references: [id], onDelete: Cascade)

  @@id([eventId, djId])
  @@index([djId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String?
  reporter   User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType ReportTargetType
  targetId   String
  reason     String
  detail     String?
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// Append-only record of privileged actions (reviews, role changes, unpublish).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
