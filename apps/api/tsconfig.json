{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts"
  ],
  // Bind mounts (Docker on Windows/macOS) do not deliver file-system events, so
  // `tsc --watch` must poll. Without this, edits never trigger a recompile.
  "watchOptions": {
    "watchFile": "fixedpollinginterval",
    "watchDirectory": "fixedpollinginterval"
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.itest.ts"
  ]
}