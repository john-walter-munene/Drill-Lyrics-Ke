{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Shared modules in `packages/shared` import each other with `.ts`
    // extensions so they run unbuilt under `node --experimental-strip-types`.
    // Without these two flags, any API file that imports the shared package
    // pulls those specifiers into the API's compile graph and `tsc` rejects
    // them (TS5097). `rewriteRelativeImportExtensions` (TypeScript 5.7) emits
    // the correct `./x.js` specifier in `dist`, so the CommonJS build is
    // unaffected.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ],
  // Bind mounts (Docker on Windows/macOS) do not deliver file-system events, so
  // `tsc --watch` must poll. Without this, edits never trigger a recompile.
  "watchOptions": {
    "watchFile": "fixedpollinginterval",
    "watchDirectory": "fixedpollinginterval"
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.itest.ts"
  ]
}
