# ─── Core ───────────────────────────────────────────────
NODE_ENV=development

# ─── Observability / logging ────────────────────────────
# Structured JSON logs go to stdout (info/debug/verbose) and stderr
# (warn/error), each enriched with the request correlation id.
# error | warn | info | debug | verbose. Defaults to "info".
LOG_LEVEL=info

# ─── Database / cache ───────────────────────────────────
# Matches infra/docker-compose.yml. Start it with `npm run db:up`.
DATABASE_URL=postgresql://drillke:drillke@localhost:5432/drillke?schema=public
REDIS_URL=redis://localhost:6379

# ─── API ────────────────────────────────────────────────
API_PORT=4000
# Placeholder ONLY. Production refuses to boot with a default/weak value.
# Generate one: `openssl rand -hex 32`.
JWT_SECRET=change-me-in-prod
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Cap on request bodies (submissions carry lyrics text, so keep it under 1mb).
MAX_BODY_SIZE=512kb

# ─── Rate limiting / abuse protection ──────────────────
THROTTLE_TTL_MS=60000
# Global ceiling per IP for ordinary browsing.
THROTTLE_LIMIT=120
# Stricter budget for auth routes (credential-stuffing protection).
THROTTLE_AUTH_LIMIT=20
# Stricter budget for writes (lyrics submissions, reports, votes).
THROTTLE_WRITE_LIMIT=30

# ─── Web ────────────────────────────────────────────────
# Inlined into the browser bundle at build time — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site origin: canonical URLs, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── YouTube ────────────────────────────────────────────
# Data API v3 key, used server-side only (channel + video metadata import).
# Unset = import features disabled, playback still works.
YOUTUBE_API_KEY=

# ─── Seed (npm run db:seed) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@drillke.local
SEED_ADMIN_PASSWORD=change-me-now
