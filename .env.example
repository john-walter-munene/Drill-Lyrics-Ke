# ─────────────────────────────────────────────────────────────────────────────
# DrillKe — THE environment file. There is exactly one.
#
#   cp .env.example .env        (then edit .env)
#
# `.env` at the repo root is read by everything:
#   * `npm run dev:stack` / `npm run stack:up` — Compose loads it as the project
#     dotenv file AND passes it into both containers (`env_file`), so nothing has
#     to be duplicated in a compose file.
#   * `npm run dev` / `npm run dev:api` on the host — Next.js and the API read it
#     directly (`apps/api/src/common/load-env.ts`).
#
# Do not create an `infra/.env`, an `.env.local`, or per-app env files: none of
# them is read, and a value set there is silently ignored.
#
# Changed a value while the Docker stack is running? Environment is fixed when a
# container is created:
#   npm run dev:stack:restart        (or: npm run stack:up)
#
# `.env` is git-ignored. This file is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# error | warn | info | debug | verbose.
LOG_LEVEL=info

# ── Ports ───────────────────────────────────────────────────────────────────
# Docker stack only: the ports published on your machine. Inside the containers
# the API is always :4000, the web app :3000 and PostgreSQL :5432.
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432

# ── Database (PostgreSQL runs inside the api container) ─────────────────────
POSTGRES_DB=drillke
POSTGRES_USER=drillke
POSTGRES_PASSWORD=drillke
# Host development only (`npm run dev` against the Dockerised database). In the
# containers DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql://drillke:drillke@localhost:5432/drillke?schema=public

# ── API ─────────────────────────────────────────────────────────────────────
# Must be >= 32 characters. Production refuses to boot with a short or
# placeholder value. Generate one: `openssl rand -hex 32`.
JWT_SECRET=local-dev-only-secret-change-before-deploying-0000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Cap on request bodies (submissions carry lyrics text, so keep it under 1mb).
MAX_BODY_SIZE=512kb

# Rate limiting / abuse protection.
THROTTLE_TTL_MS=60000
# Global ceiling per IP for ordinary browsing.
THROTTLE_LIMIT=120
# Stricter budget for auth routes (credential-stuffing protection).
THROTTLE_AUTH_LIMIT=20
# Stricter budget for writes (lyrics submissions, reports, votes).
THROTTLE_WRITE_LIMIT=30

# ── Web ─────────────────────────────────────────────────────────────────────
# Inlined into the browser bundle — no secrets here.
# The browser reaches the API through the published API_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site origin: canonical URLs, sitemap, OpenGraph, links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The API's own origin, used by scripts and server-to-server calls outside
# Docker. Inside the compose network API_INTERNAL_URL is set to http://api:4000
# by the compose file itself — you never set that here.
API_URL=http://localhost:4000

# ── Staff account (/admin) ──────────────────────────────────────────────────
# The seed creates the FIRST admin from these values — this is the account you
# sign in with at /sign-in, then /admin. Two rules that actually bite:
#   * the password must be at least 10 characters. A shorter one makes the seed
#     REFUSE to run, and then NO admin account exists at all;
#   * an existing account keeps its old password unless
#     SEED_ADMIN_RESET_PASSWORD=true, which re-applies the password and the
#     admin role on every boot. Set it true while you are setting up, then
#     false.
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@drillke.local
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_RESET_PASSWORD=false

# ── YouTube import ──────────────────────────────────────────────────────────
# YouTube Data API v3 key (Google Cloud Console → APIs & Services → enable
# "YouTube Data API v3" → Credentials → API key), used server-side only.
# Adding an artist from a YouTube link does NOT work without it; playback of
# embedded video does. Restart the api container after setting it:
#   npm run dev:stack:restart
#   docker exec drill-lyrics-key-dev-api printenv YOUTUBE_API_KEY
YOUTUBE_API_KEY=
# Run the periodic new-upload sync inside the API process. Adding an artist
# imports the whole channel immediately either way; this only keeps the
# catalogue current with uploads published later.
EMBED_WORKER=false
# How often that cycle runs, in milliseconds (default 15 minutes).
INGEST_INTERVAL_MS=900000
# How many pages (50 uploads each) one periodic cycle reads per channel.
# Defaults to the whole channel — a cycle is therefore bounded by YouTube's
# pagination, not by this number.
# YOUTUBE_WORKER_PAGES=10

# ── Catalogue publication ───────────────────────────────────────────────────
# What happens to a song imported from YouTube.
#   true  (default) — music uploads go straight into the public catalogue on the
#                     artist page and /songs, and revalidation is triggered, so
#                     they are visible within seconds of the import finishing.
#   false           — they stay drafts in /admin → Song imports until published.
# Uploads the importer cannot confirm as music are drafts either way; they never
# publish themselves.
YOUTUBE_AUTO_PUBLISH=true

# ── Email (review outcomes, password reset, account deletion) ───────────────
# `mock` (default) logs the message instead of sending it — no SMTP account
# needed for development. `smtp` uses the settings below; a misconfigured SMTP
# setup is reported at boot and refuses to send, so a reset link is never
# silently dropped. In production an incomplete SMTP setup refuses to boot.
MAIL_PROVIDER=mock
# 587 negotiates STARTTLS; 465 is implicit TLS and is inferred from the port.
SMTP_HOST=
SMTP_PORT=587
# Optional: leave both unset for a relay that needs no auth (local MailHog).
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Must contain an address.
MAIL_FROM=DrillKe <no-reply@drillke.com>
# Override the port-based TLS inference, or accept a self-signed certificate.
# SMTP_SECURE=true
# SMTP_ALLOW_INVALID_CERT=true
